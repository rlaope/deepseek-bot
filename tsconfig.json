{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    "sourceMap": false,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": [
    "index.ts",
    "messages.ts",
    "i18n.ts",
    "notes.ts",
    "progress.ts",
    "usage.ts",
    "injection.ts",
    "recallContext.ts",
    "safeWrite.ts",
    "netPolicy.ts",
    "transports/**/*.ts",
    "types/**/*.ts",
    "tools/**/*.ts",
    "service/**/*.ts",
    "watch/**/*.ts",
    "recall/**/*.ts",
    "tui/**/*.ts"
  ]
}
